{
  "expo": {
    "name": "SafeTrace",
    "slug": "safetrace-cm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#080c14"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f97316"
      },
      "package": "cm.safetrace.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "cm.safetrace.app",
      "supportsTablet": true,
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SafeTrace utilise votre position pour les alertes de proximité.",
        "NSCameraUsageDescription": "Pour prendre une photo de la personne disparue.",
        "NSPhotoLibraryUsageDescription": "Pour choisir une photo depuis votre galerie.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SafeTrace utilise votre position pour les alertes de proximité.",
        "UIBackgroundModes": ["remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-location",
      "expo-image-picker",
      "expo-notifications",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
